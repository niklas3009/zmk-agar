#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Basis QWERTZ
        default_layer {
            bindings = <
&lt 2 ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I      &kp O    &kp P     &kp LBKT   &kp SEMI
&kp TAB    &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K      &kp L    &kp SQT   &kp RET
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP    &kp RIGHT
                  &kp LCTRL  &kp LALT  &mo 1         &kp SPACE  &kp LEFT  &kp DOWN
            >;
        };

        // Layer 1: Zahlen, Symbole & Backspace (Fn halten)
        nav_layer {
            bindings = <
&trans     &kp N1     &kp N2     &kp N3       &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0        &kp MINUS   &none
&trans     &kp RA(Q)  &none      &kp RA(E)    &none      &none      &kp RA(N7) &kp RA(N8) &kp RA(N9) &kp RA(N0) &kp RA(MINUS) &kp BSPC
&trans     &kp NUBS   &kp LS(NUBS) &kp RA(NUBS) &none    &none      &none      &none      &none      &none      &kp UP        &kp RIGHT
                      &trans     &trans       &trans                &trans     &kp LEFT   &kp DOWN
            >;
        };

        // Layer 2: F-Tasten & Symbole (Esc halten)
        media_layer {
            bindings = <
&trans     &kp F1     &kp F2     &kp F3       &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10       &kp F11     &kp F12
&trans     &kp RA(Q)  &none      &kp RA(E)    &none      &none      &kp RA(N7) &kp RA(N8) &kp RA(N9) &kp RA(N0) &kp RA(MINUS) &none
&trans     &kp NUBS   &kp LS(NUBS) &kp RA(NUBS) &none    &none      &none      &none      &none      &none      &kp UP        &kp RIGHT
                      &trans     &trans       &trans                &trans     &kp LEFT   &kp DOWN
            >;
        };
    };
};